{
  "expo": {
    "name": "HomeHero",
    "slug": "fe",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/Logo Home Service Booking (1).png",
    "splash": {
      "image": "./assets/Logo Home Service Booking (1).png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    },
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/Logo Home Service Booking (1).png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/Logo Home Service Booking (1).png"
    },
    "plugins": [
      "expo-font",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": false
          }
        }
      ]
    ]
  }
}
