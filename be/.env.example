NODE_ENV=development
PORT=5000
MONGO_URI=mongodb+srv://<username>:<password>@home-service-booking.qhhtk7g.mongodb.net/?appName=home-service-booking
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=1d
CLIENT_URL=http://localhost:8080
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
PAYOS_RETURN_URL=http://localhost:3000/provider/membership/payment-result
PAYOS_CANCEL_URL=http://localhost:3000/provider/membership/payment-cancelled

VIETMAP_API_KEY=

# Rate Limiting (V-10) - optional overrides
RATE_LIMIT_GLOBAL_WINDOW_MS=900000
RATE_LIMIT_GLOBAL_MAX=300
RATE_LIMIT_UPLOAD_WINDOW_MS=60000
RATE_LIMIT_UPLOAD_MAX=10
RATE_LIMIT_AVAILABILITY_WINDOW_MS=60000
RATE_LIMIT_AVAILABILITY_MAX=60

# Reverse Proxy & Client IP Trust (V-16)
# Configures Express 'trust proxy' to determine the real client IP for rate limiting and logging.
# Options:
# - false (default in dev/test): Do not trust proxy headers; uses direct socket IP to prevent IP spoofing.
# - 1 (default in production): Trust 1 hop (standard for single reverse proxy: Render, Railway, single Nginx, AWS ALB).
# - 2: Trust 2 hops (e.g. Cloudflare -> Nginx/Render -> Node app).
# - 'loopback': Trust loopback addresses only (e.g. local Nginx proxy on 127.0.0.1).
# - comma-separated list or CIDR: e.g. 'loopback, 10.0.0.0/8'
# NEVER set to 'true' in production unless every header is strictly sanitized by the outer edge proxy.
TRUST_PROXY=false


