NODE_ENV=development
PORT=5000
MONGO_URI=mongodb+srv://<username>:<password>@home-service-booking.qhhtk7g.mongodb.net/?appName=home-service-booking
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=1d
# CORS & Allowed Origins (V-15)
# In production and staging (NODE_ENV=production or staging or unset), CLIENT_URL is mandatory and CANNOT contain '*'.
# Staging environments MUST declare full, explicit domain(s) in CLIENT_URL (no wildcards allowed).
# Multiple origins can be comma-separated: e.g. CLIENT_URL=https://myhomecare.com,https://admin.myhomecare.com
# In local development:
# - Next.js web runs on port 3000 (http://localhost:3000)
# - Expo mobile web (Metro) runs on port 8081 (http://localhost:8081). If testing Expo web, add its origin to CLIENT_URL:
#   CLIENT_URL=http://localhost:3000,http://localhost:8081
CLIENT_URL=http://localhost:3000

# Google OAuth (comma-separated Android/iOS/Web client IDs)
GOOGLE_CLIENT_IDS=

# Email / SMTP (optional in dev, required for real email verification)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Cloudinary (optional in dev; falls back to base64 data URLs)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_URL=

# Seed Passwords (dev/test only; leave empty to generate random passwords on seed)
SEED_PASSWORD=
SEED_ADMIN_PASSWORD=

PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
PAYOS_RETURN_URL=http://localhost:3000/provider/membership/payment-result
PAYOS_CANCEL_URL=http://localhost:3000/provider/membership/payment-cancelled

VIETMAP_API_KEY=

# Rate Limiting (V-10) - optional overrides
RATE_LIMIT_GLOBAL_WINDOW_MS=900000
RATE_LIMIT_GLOBAL_MAX=300
RATE_LIMIT_UPLOAD_WINDOW_MS=60000
RATE_LIMIT_UPLOAD_MAX=10
RATE_LIMIT_AVAILABILITY_WINDOW_MS=60000
RATE_LIMIT_AVAILABILITY_MAX=60
RATE_LIMIT_LOGIN_ACCOUNT_WINDOW_MS=900000
RATE_LIMIT_LOGIN_ACCOUNT_MAX=5
RATE_LIMIT_REGISTER_WINDOW_MS=3600000
RATE_LIMIT_REGISTER_MAX=5

# User Upload Quota (V-23) - total MB upload volume limit per user
UPLOAD_USER_DAILY_LIMIT_MB=50
UPLOAD_USER_DAILY_WINDOW_MS=86400000

# Provider Search Candidate Ceiling & Radius Bounds (V-24)
PROVIDER_SEARCH_MAX_CANDIDATES=100
PROVIDER_RECOMMEND_MAX_CANDIDATES=200
PROVIDER_MAX_RADIUS_KM=100

# Reverse Proxy & Client IP Trust (V-16)
# Configures Express 'trust proxy' to determine the real client IP for rate limiting and logging.
# Options:
# - false (default in dev/test): Do not trust proxy headers; uses direct socket IP to prevent IP spoofing.
# - 1 (default in production): Trust 1 hop (standard for single reverse proxy: Render, Railway, single Nginx, AWS ALB).
# - 2: Trust 2 hops (e.g. Cloudflare -> Nginx/Render -> Node app).
# - 'loopback': Trust loopback addresses only (e.g. local Nginx proxy on 127.0.0.1).
# - comma-separated list or CIDR: e.g. 'loopback, 10.0.0.0/8'
# NEVER set to 'true' in production unless every header is strictly sanitized by the outer edge proxy.
TRUST_PROXY=false

# Transaction & Concurrency Policy (V-12 / V-27)
# In production (NODE_ENV=production), MongoDB multi-document transactions are mandatory.
# If transactions fail in production, operations return 503 (fail-fast, no silent non-transactional execution).
# In local development:
# - Option A (Recommended - 1-node replica set via Docker):
#     docker run -d --name mongo-rs -p 27017:27017 mongo:7 mongod --replSet rs0 --bind_ip_all
#     docker exec -it mongo-rs mongosh --eval "rs.initiate()"
#     MONGO_URI=mongodb://localhost:27017/homecare?replicaSet=rs0
# - Option B (Native mongod 1-node replica set):
#     mongod --replSet rs0 --dbpath <data_directory>
#     mongosh --eval "rs.initiate()"
#     MONGO_URI=mongodb://localhost:27017/homecare?replicaSet=rs0
# - Option C (Standalone MongoDB fallback without replica set):
#     Set ALLOW_NO_TRANSACTION=true to allow fallback to non-transactional execution with a console warning.
# Default: false
ALLOW_NO_TRANSACTION=false

# Payment Simulation Switch (V-28)
# Master switch for the development/demo membership payment simulation (client-sent simulateSuccess).
# Simulation only runs when this flag is true AND NODE_ENV is 'development' or 'test'.
# Default: false
ALLOW_PAYMENT_SIMULATION=false


